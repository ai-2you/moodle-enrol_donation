<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/donation/db" VERSION="20260928" COMMENT="XMLDB file for Moodle enrol/donation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="enrol_donation_intent" COMMENT="Immutable amount quote for a donation, created before the payer is known. Not personal data: the payer is only ever payments.userid.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to enrol.id"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="15" NOTNULL="true" SEQUENCE="false" DECIMALS="5" COMMENT="Quoted amount, rounded and immutable"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" SEQUENCE="false" COMMENT="ISO 4217 currency code, copied from the instance at creation time"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timedelivered" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = not delivered yet"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid" TYPE="foreign" FIELDS="instanceid" REFTABLE="enrol" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timedelivered-timecreated" UNIQUE="false" FIELDS="timedelivered, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
